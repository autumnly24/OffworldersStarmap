lderStructure":{"folderName":"__ROOT","children":[{"functionName":"CustomSeededRandomize"},{"functionName":"DailySeededRandomize"},{"functionName":"WeightedRandomize"}]},"eventsBasedBehaviors":[],"eventsBasedObjects":[]},{"author":"","category":"General","dimension":"","extensionNamespace":"","fullName":"Signals","gdevelopVersion":"","helpPath":"","iconUrl":"data:image/svg+xml;base64,","name":"Signals","previewIconUrl":"https://asset-resources.gdevelop.io/public-resources/Icons/a422fe56b8214e5d8b8e5ca6ad8f6b9598f89e6bd3af47c9e25d1777c2534c63_signal-variant.svg","shortDescription":"Adds Call Signal as an action and On Signal Call as a condition, allowing re-use of multiple actions easily. Each signal can be called with or without a strength value.","version":"1.2.3","description":["Allows for calling and on call signals within the Action Sheet.  ","Useful for re-use of the same actions for different calls of the same signal.  ","  ","Write \"On Signal Call\" then use \"Call Signal\" in your program for use.  ","Either can be used in front of another, On Signal Call can appear before Call Signal in the action sheet, and vice versa.  ","  ","Each Signal can be given its own strength value, which can be accessed with `Signals::GetStrength(\"Signal Name\")`  "],"tags":["general","signals","signal","calls","functions"],"authorIds":["9AJFDUCQG2hiUqekfo0Y9HVSiRX2"],"dependencies":[],"globalVariables":[],"sceneVariables":[],"eventsFunctions":[{"description":"Calls a Signal.","fullName":"Call Signal","functionType":"Action","name":"CallSignal","sentence":"Call Signal _PARAM1_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const extName = \"Signals\";","const sigName = eventsFunctionContext.getArgument(\"SignalName\");","globalThis[extName] = globalThis[extName] || {","    activeCalls: new Map(), incomingCalls: new Map(),","    totalCalls: new Map(), signalStrengths: new Map()","};","globalThis[extName].incomingCalls.set(sigName, undefined);","globalThis