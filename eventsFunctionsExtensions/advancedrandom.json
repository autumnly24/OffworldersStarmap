  "eventsFunctions": [
    {
      "description": "Returns a random number between 1 and the maximum value, seeded based on the input.",
      "fullName": "Custom Seeded Random",
      "functionType": "Expression",
      "name": "CustomSeededRandomize",
      "sentence": "",
      "events": [
        {
          "type": "BuiltinCommonInstructions::Standard",
          "conditions": [
            {
              "type": {
                "inverted": true,
                "value": "VariableChildExists2"
              },
              "parameters": [
                "CustomSeeds",
                "SeedName"
              ]
            }
          ],
          "actions": [
            {
              "type": {
                "value": "SetStringVariable"
              },
              "parameters": [
                "CustomSeeds[SeedName]",
                "=",
                "SeedNumber"
              ]
            }
          ]
        },
        {
          "type": "BuiltinCommonInstructions::Standard",
          "conditions": [],
          "actions": [
            {
              "type": {
                "value": "SetNumberVariable"
              },
              "parameters": [
                "CustomSeeds[SeedName]",
                "=",
                "mod(CustomSeeds[SeedName] * 1664525 + 1013904223, 4294967296)"
              ]
            },
            {
              "type": {
                "value": "SetReturnNumber"
              },
              "parameters": [
                "mod(CustomSeeds[SeedName] * 9973, Maximum) + 1"
              ]
            }
          ]
        }
      ],
      "expressionType": {
        "type": "expression"
      },
      "parameters": [
        {
          "description": "Maximum Value",
          "name": "Maximum",
          "type": "expression"
        },
        {
          "description": "Seed Name",
          "name": "SeedName",
          "type": "string"
        },
        {
          "description": "Seed Number",
          "name": "SeedNumber",
          "type": "expression"
        }
      ],
      "objectGroups": []
    },
    {
      "description": "Returns a random number between 1 and the maximum value, seeded based on the day.",
      "fullName": "Daily Seeded Random",
      "functionType": "Expression",
      "name": "DailySeededRandomize",
      "sentence": "",
      "events": [
        {
          "type": "BuiltinCommonInstructions::Standard",
          "conditions": [
            {
              "type": {
                "value": "SceneJustBegins"
              },
              "parameters": [
                ""
              ]
            }
          ],
          "actions": [
            {
              "type": {
                "value": "SetNumberVariable"
              },
              "parameters": [
                "Day",
                "=",
                "(Time(\"year\")* 1009)+Time(\"day\")"
              ]
            },
            {
              "type": {
                "value": "SetNumberVariable"
              },
              "parameters": [
                "CurrentSeedDaily",
                "=",
                "Day"
              ]
            }
          ]
        },
        {
          "type": "BuiltinCommonInstructions::Standard",
          "conditions": [],
          "actions": [
            {
              "type": {
                "value": "SetNumberVariable"
              },
              "parameters": [
                "CurrentSeedDaily",
                "=",
                "mod(CurrentSeedDaily * 1664525 + 1013904223, 4294967296)"
              ]
            },
            {
              "type": {
                "value": "SetReturnNumber"
              },
              "parameters": [
                "mod(CurrentSeedDaily * 9973, Maximum) + 1"
              ]
            }
          ]
        }
      ],
      "expressionType": {
        "type": "expression"
      },
      "parameters": [
        {
          "description": "Maximum Value",
          "name": "Maximum",
          "type": "expression"
        }
      ],
      "objectGroups": []
    },
    {
      "description": "Randomly returns the name of a child of a structure, using the structure's child's values as weights.",
      "fullName": "Weighted Randomization",
      "functionType": "StringExpression",
      "name": "WeightedRandomize",
      "sentence": "",
      "events": [
        {
          "type": "BuiltinCommonInstructions::Standard",
          "conditions": [
            {
              "type": {
                "value": "NumberVariable"
              },
              "parameters": [
                "Total",
                ">",
                "0"
              ]
            }
          ],
          "actions": [
            {
              "type": {
                "value": "SetNumberVariable"
              },
              "parameters": [
                "Total",
                "=",
                "0"
              ]
            }
          ]
        },
        {
          "type": "BuiltinCommonInstructions::Standard",
          "conditions": [],
          "actions": [
            {
              "type": {
                "value": "CopyArgumentToVariable2"
              },
              "parameters": [
                "\"Structure\"",
                "StructureVariable"
              ]
            }
          ]
        },
        {
          "type": "BuiltinCommonInstructions::ForEachChildVariable",
          "iterableVariableName": "StructureVariable",
          "valueIteratorVariableName": "Child",
          "keyIteratorVariableName": "",
          "conditions": [],
          "actions": [
            {
              "type": {
                "value": "SetNumberVariable"
              },
              "parameters": [
                "Total",
                "+",
                "Child"
              ]
            }
          ]
        },
        {
          "type": "BuiltinCommonInstructions::Standard",
          "conditions": [],
          "actions": [
            {
              "type": {
                "value": "SetNumberVariable"
              },
              "parameters": [
                "RandomNumberWeighted",
                "=",
                "RandomInRange(1, Total)-1"
              ]
            },
            {
              "type": {
                "value": "SetNumberVariable"
              },
              "parameters": [
                "CulmativeSum",
                "=",
                "0"
              ]
            }
          ]
        },
        {
          "type": "BuiltinCommonInstructions::ForEachChildVariable",
          "iterableVariableName": "StructureVariable",
          "valueIteratorVariableName": "Child",
          "keyIteratorVariableName": "ChildName",
          "conditions": [
            {
              "type": {
                "value": "NumberVariable"
              },
              "parameters": [
                "Total",
                "!=",
                "0"
              ]
            }
          ],
          "actions": [
            {
              "type": {
                "value": "SetNumberVariable"
              },
              "parameters": [
                "CulmativeSum",
                "+",
                "Child"
              ]
            }
          ],
          "events": [
            {
              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [
                {
                  "type": {
                    "value": "NumberVariable"
                  },
                  "parameters": [
                    "RandomNumberWeighted",
                    "<",
                    "CulmativeSum"
                  ]
                },
                {
                  "type": {
                    "value": "NumberVariable"
                  },
                  "parameters": [
                    "Total",
                    "!=",
                    "0"
                  ]
                }
              ],
              "actions": [
                {
                  "type": {
                    "value": "SetNumberVariable"
                  },
                  "parameters": [
                    "Total",
                    "=",
                    "0"
                  ]
                },
                {
                  "type": {
                    "value": "SetReturnString"
                  },
                  "parameters": [
                    "ChildName"
                  ]
                }
              ]
            }
          ]
        }
      ],
      "expressionType": {
        "type": "string"
      },
      "parameters": [
        {
          "description": "Structure Variable",
          "name": "Structure",
          "type": "variable"
        }
      ],
